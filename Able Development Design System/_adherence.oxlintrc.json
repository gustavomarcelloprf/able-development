{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/identidade/**",
              "ui_kits/proposta/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Switzer))/i]",
        "message": "Font not provided by the design system. Available: Switzer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abre'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Abre> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abre'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Abre> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abre'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:deck|doc|social)$/]",
        "message": "<Abre> size must be one of 'deck' | 'doc' | 'social'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: variant, height, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:logo|logo-inverted|symbol|tile)$/]",
        "message": "<BrandMark> variant must be one of 'logo' | 'logo-inverted' | 'symbol' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Button> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|children|dashed|tone|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: label, title, children, dashed, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Card> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Comparacao'] > JSXAttribute > JSXIdentifier[name!=/^(?:a|b|variant|direction|style|key|ref|className|style|children)$/]",
        "message": "<Comparacao> doesn't accept that prop. Declared props: a, b, variant, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Comparacao'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|voz)$/]",
        "message": "<Comparacao> variant must be one of 'default' | 'voz'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Comparacao'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<Comparacao> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|onPrev|onNext|style|key|ref|className|style|children)$/]",
        "message": "<DeckNav> doesn't accept that prop. Declared props: index, total, onPrev, onNext, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FatoLista'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<FatoLista> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|help|placeholder|value|defaultValue|onChange|type|tone|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: id, label, help, placeholder, value, defaultValue, onChange, type, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Input> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkDoc'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|inline|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<LinkDoc> doesn't accept that prop. Declared props: href, inline, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|primaryLabel|secondaryLabel|onPrimary|onSecondary|open|fixed|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, children, primaryLabel, secondaryLabel, onPrimary, onSecondary, open, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotaTecnica'] > JSXAttribute > JSXIdentifier[name!=/^(?:strong|children|style|key|ref|className|style|children)$/]",
        "message": "<NotaTecnica> doesn't accept that prop. Declared props: strong, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PassoLista'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|style|key|ref|className|style|children)$/]",
        "message": "<PassoLista> doesn't accept that prop. Declared props: items, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PassoLista'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<PassoLista> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pendencia'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Pendencia> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pendencia'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Pendencia> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placa'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|highlight|children|style|key|ref|className|style|children)$/]",
        "message": "<Placa> doesn't accept that prop. Declared props: label, value, highlight, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|total|unit|items|style|key|ref|className|style|children)$/]",
        "message": "<PlanoCard> doesn't accept that prop. Declared props: name, total, unit, items, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
